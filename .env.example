# Environment example — copy ke .env dan isi nilai nyata. JANGAN commit .env.
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-for-local-only
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
# Produksi/pilot:
# DATABASE_URL=postgresql://presensi_app:***@127.0.0.1:5432/ganeshatech_presensi
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
